{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranches": [
    "stronghold"
  ],
  "automerge": false,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "prPriority": 10
  },
  "packageRules": [
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "frontend-next/**"
      ],
      "groupName": "frontend npm"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "groupName": "backend npm"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "flask python"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "docker base images"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
